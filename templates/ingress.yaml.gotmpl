{{- if and .Values.ingress.enabled .Values.ingress.domain }}
{{- include "polytope-server.validateFrontendServiceExposure" . -}}
{{- $host := include "polytope-server.ingressHost" . }}
{{- $ingressBackendPortName := include "polytope-server.ingressBackendPortName" . }}
{{- $userAnnotations := .Values.ingress.annotations | default dict }}
{{- $hasCertManager := or (hasKey $userAnnotations "cert-manager.io/cluster-issuer") (hasKey $userAnnotations "cert-manager.io/issuer") }}
{{- $controller := include "polytope-server.ingressController" . }}
{{- $stickyHashBy := .Values.ingress.stickyHashBy | default "" }}
{{- $communityStickyHashBy := .Values.ingress.communityStickyHashBy | default $stickyHashBy }}
{{- if eq $controller "nginx-inc" }}
{{- if .Values.ingress.virtualServer.enabled }}
{{- /* Keep the existing Ingress name as a DNS and certificate ownership shim.
      The non-NGINX class prevents it competing with the VirtualServer for the host. */}}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ include "polytope-server.fullname" . }}-ingress
  labels:
    {{- include "polytope-server.labels" . | nindent 4 }}
  annotations:
    dns.operators.ecmwf.int/on-transport-server: vs-transport-https
    {{- range $key, $value := $userAnnotations }}
    {{- if hasPrefix "cert-manager.io/" $key }}
    {{ $key }}: {{ $value | quote }}
    {{- end }}
    {{- end }}
spec:
  ingressClassName: {{ .Values.ingress.virtualServer.dnsIngress.className | quote }}
  rules:
    - host: {{ $host | quote }}
  {{- if .Values.ingress.tls }}
  tls:
    {{- range .Values.ingress.tls }}
    - secretName: {{ .secretName }}
      hosts:
        - {{ $host | quote }}
    {{- end }}
  {{- else if $hasCertManager }}
  tls:
    - secretName: {{ $host | replace "." "-" }}-tls
      hosts:
        - {{ $host | quote }}
  {{- end }}
{{- else }}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ include "polytope-server.fullname" . }}-ingress
  labels:
    {{- include "polytope-server.labels" . | nindent 4 }}
  annotations:
    dns.operators.ecmwf.int/on-transport-server: vs-transport-https
    nginx.org/mergeable-ingress-type: master
    {{- if $stickyHashBy }}
    {{- /* lb-method is inherited by minions from the master, so the frontend
           minion's upstream picks this up. */}}
    nginx.org/lb-method: {{ printf "hash %s consistent" $stickyHashBy | quote }}
    {{- end }}
    {{- with $userAnnotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
spec:
  ingressClassName: {{ .Values.ingress.className }}
  rules:
    - host: {{ $host | quote }}
  {{- if .Values.ingress.tls }}
  tls:
    {{- range .Values.ingress.tls }}
    - secretName: {{ .secretName }}
      hosts:
        - {{ $host | quote }}
    {{- end }}
  {{- else if $hasCertManager }}
  tls:
    - secretName: {{ $host | replace "." "-" }}-tls
      hosts:
        - {{ $host | quote }}
  {{- end }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ include "polytope-server.fullname" . }}-ingress-frontend
  labels:
    {{- include "polytope-server.labels" . | nindent 4 }}
  annotations:
    nginx.org/mergeable-ingress-type: minion
spec:
  ingressClassName: {{ .Values.ingress.className }}
  rules:
    - host: {{ $host | quote }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ include "polytope-server.fullname" . }}-frontend
                port:
                  name: {{ $ingressBackendPortName }}
{{- end }}
{{- else if eq $controller "nginx-community" }}
{{- /*
Community ingress-nginx (kubernetes/ingress-nginx). Single Ingress per service
on the same host; community nginx does not merge master/minion. Force HTTPS at
the controller via ssl-redirect so requests on :80 are 308'd before any body
is served. These redirect defaults are merged under user annotations so an
operator can opt out by explicitly setting the same keys to "false".

NGINX Inc / Bologna-only annotation keys (`nginx.org/*`, `dns.operators.ecmwf.int/*`)
are stripped here so chart-default or values-inherited Bologna keys don't leak
into community-controller ingresses where they would be silently ignored or
misinterpreted.
*/ -}}
{{- $filtered := dict -}}
{{- range $k, $v := $userAnnotations -}}
  {{- if not (or (hasPrefix "nginx.org/" $k) (hasPrefix "dns.operators.ecmwf.int/" $k)) -}}
    {{- $_ := set $filtered $k $v -}}
  {{- end -}}
{{- end -}}
{{- $secureDefaults := dict
  "nginx.ingress.kubernetes.io/ssl-redirect" "true"
  "nginx.ingress.kubernetes.io/force-ssl-redirect" "true" }}
{{- /* Consistent-hash broker stickiness. ingress-nginx implements upstream-hash-by
       with ketama consistent hashing over pod endpoints, so it is resilient to
       broker autoscaling/restarts. Placed in defaults so an operator annotation
       can still override it. */}}
{{- if $communityStickyHashBy }}
{{-   $_ := set $secureDefaults "nginx.ingress.kubernetes.io/upstream-hash-by" $communityStickyHashBy }}
{{- end }}
{{- $annotations := mergeOverwrite (deepCopy $secureDefaults) $filtered }}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ include "polytope-server.fullname" . }}-ingress
  labels:
    {{- include "polytope-server.labels" . | nindent 4 }}
  annotations:
    {{- toYaml $annotations | nindent 4 }}
spec:
  ingressClassName: {{ .Values.ingress.className }}
  rules:
    - host: {{ $host | quote }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ include "polytope-server.fullname" . }}-frontend
                port:
                  name: {{ $ingressBackendPortName }}
  {{- if .Values.ingress.tls }}
  tls:
    {{- range .Values.ingress.tls }}
    - secretName: {{ .secretName }}
      hosts:
        - {{ $host | quote }}
    {{- end }}
  {{- else if $hasCertManager }}
  tls:
    - secretName: {{ $host | replace "." "-" }}-tls
      hosts:
        - {{ $host | quote }}
  {{- end }}
{{- end }}
{{- end }}
